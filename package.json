{
  "name": "relai-sdk",
  "version": "0.0.1",
  "description": "Official SDK for RelayAI - Monetize any API endpoint with x402 micropayments.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "api",
    "monetization",
    "micropayments",
    "x402",
    "solana",
    "blockchain",
    "payments"
  ],
  "author": "RelayAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/relayai/sdk"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "x402-solana": "latest"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "eslint": "^8.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^1.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    }
  }
}
