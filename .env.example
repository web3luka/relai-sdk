# ── EVM (Base / SKALE / Polygon) ──────────────────────────────────────────────
EVM_PRIVATE_KEY=0x...

# ── Solana ────────────────────────────────────────────────────────────────────
# SOLANA_PRIVATE_KEY=base58...
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Tempo (EVM) ──────────────────────────────────────────────────────────────
# TEMPO_PRIVATE_KEY=0x...

# ── MPP Server (EVM) ────────────────────────────────────────────────────────
# MPP_SECRET_KEY=my-secret-key-32-chars-minimum!!
# RECIPIENT_WALLET=0x...                          # EVM address for Tempo/SKALE/Base servers

# ── MPP Server (Solana) ─────────────────────────────────────────────────────
# SOLANA_RECIPIENT_WALLET=base58...               # Solana address for Solana MPP server

# ── SKALE RPC (gas-free, default works out of the box) ───────────────────────
# SKALE_RPC_URL=https://skale-base.skalenodes.com/v1/base
